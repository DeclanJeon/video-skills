{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "pin": {
          "$ref": "#/$defs/Pin"
        },
        "source_clip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Clip"
        },
        "source_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "range_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range Revision"
        },
        "acceptance_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Revision"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "modality": {
          "minLength": 1,
          "title": "Modality",
          "type": "string"
        },
        "imports": {
          "items": {
            "type": "string"
          },
          "title": "Imports",
          "type": "array"
        },
        "excludes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Excludes",
          "type": "array"
        },
        "native_asset_id": {
          "minLength": 1,
          "title": "Native Asset Id",
          "type": "string"
        },
        "native_reference_id": {
          "minLength": 1,
          "title": "Native Reference Id",
          "type": "string"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        }
      },
      "required": [
        "pin",
        "role",
        "modality",
        "imports",
        "native_asset_id",
        "native_reference_id",
        "ready"
      ],
      "title": "Binding",
      "type": "object"
    },
    "Pin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256",
        "path"
      ],
      "title": "Pin",
      "type": "object"
    },
    "SourceRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceRange",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/Binding"
  },
  "type": "array"
}
