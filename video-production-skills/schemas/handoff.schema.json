{
  "$defs": {
    "ApprovedConfig": {
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "scope_revision": {
          "minLength": 1,
          "title": "Scope Revision",
          "type": "string"
        },
        "coverage_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Coverage Hash",
          "type": "string"
        },
        "clip_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Clip Hash",
          "type": "string"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "audio_requested": {
          "title": "Audio Requested",
          "type": "boolean"
        },
        "reuse_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reuse_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "clip_id",
        "scope_revision",
        "coverage_hash",
        "clip_hash",
        "duration_s",
        "width",
        "height",
        "audio_requested"
      ],
      "title": "ApprovedConfig",
      "type": "object"
    },
    "Authority": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "clips": {
          "items": {
            "type": "string"
          },
          "title": "Clips",
          "type": "array"
        },
        "allowed_hashes": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hashes",
          "type": "array"
        },
        "configurations": {
          "items": {
            "$ref": "#/$defs/ApprovedConfig"
          },
          "title": "Configurations",
          "type": "array"
        },
        "account": {
          "minLength": 1,
          "title": "Account",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "transport": {
          "minLength": 1,
          "title": "Transport",
          "type": "string"
        },
        "mode": {
          "minLength": 1,
          "title": "Mode",
          "type": "string"
        },
        "max_attempts": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_active": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Max Active",
          "type": "integer"
        },
        "upload": {
          "default": false,
          "title": "Upload",
          "type": "boolean"
        },
        "generation": {
          "default": false,
          "title": "Generation",
          "type": "boolean"
        },
        "reuse": {
          "default": false,
          "title": "Reuse",
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/Pin"
        }
      },
      "required": [
        "id",
        "clips",
        "allowed_hashes",
        "configurations",
        "account",
        "model",
        "transport",
        "mode",
        "evidence"
      ],
      "title": "Authority",
      "type": "object"
    },
    "FlowReview": {
      "additionalProperties": false,
      "properties": {
        "review_render": {
          "$ref": "#/$defs/ReviewRender"
        },
        "selection_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Hash",
          "type": "string"
        },
        "clip_order": {
          "items": {
            "type": "string"
          },
          "title": "Clip Order",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "continuous_playback": {
          "title": "Continuous Playback",
          "type": "boolean"
        },
        "audio_listened": {
          "title": "Audio Listened",
          "type": "boolean"
        }
      },
      "required": [
        "review_render",
        "selection_hash",
        "clip_order",
        "passed",
        "evidence",
        "continuous_playback",
        "audio_listened"
      ],
      "title": "FlowReview",
      "type": "object"
    },
    "JoinReview": {
      "additionalProperties": false,
      "properties": {
        "join_id": {
          "minLength": 1,
          "title": "Join Id",
          "type": "string"
        },
        "before_take": {
          "minLength": 1,
          "title": "Before Take",
          "type": "string"
        },
        "after_take": {
          "minLength": 1,
          "title": "After Take",
          "type": "string"
        },
        "before_revision": {
          "exclusiveMinimum": 0,
          "title": "Before Revision",
          "type": "integer"
        },
        "after_revision": {
          "exclusiveMinimum": 0,
          "title": "After Revision",
          "type": "integer"
        },
        "before_range_revision": {
          "exclusiveMinimum": 0,
          "title": "Before Range Revision",
          "type": "integer"
        },
        "after_range_revision": {
          "exclusiveMinimum": 0,
          "title": "After Range Revision",
          "type": "integer"
        },
        "reveal_order": {
          "items": {
            "type": "string"
          },
          "title": "Reveal Order",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "continuous_playback": {
          "title": "Continuous Playback",
          "type": "boolean"
        },
        "observed_changes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Observed Changes",
          "type": "array"
        }
      },
      "required": [
        "join_id",
        "before_take",
        "after_take",
        "before_revision",
        "after_revision",
        "before_range_revision",
        "after_range_revision",
        "reveal_order",
        "passed",
        "evidence",
        "continuous_playback"
      ],
      "title": "JoinReview",
      "type": "object"
    },
    "Pin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256",
        "path"
      ],
      "title": "Pin",
      "type": "object"
    },
    "Playback": {
      "additionalProperties": false,
      "properties": {
        "asset_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Hash",
          "type": "string"
        },
        "source_range": {
          "$ref": "#/$defs/SourceRange"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "video_watched": {
          "title": "Video Watched",
          "type": "boolean"
        },
        "audio_listened": {
          "default": false,
          "title": "Audio Listened",
          "type": "boolean"
        }
      },
      "required": [
        "asset_hash",
        "source_range",
        "reviewer",
        "evidence",
        "video_watched"
      ],
      "title": "Playback",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "fulfilled": {
          "items": {
            "type": "string"
          },
          "title": "Fulfilled",
          "type": "array"
        },
        "playback": {
          "$ref": "#/$defs/Playback"
        },
        "defects": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Defects",
          "type": "array"
        },
        "post_fix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Fix"
        },
        "post_receiver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Receiver"
        },
        "conditional_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditional Policy"
        }
      },
      "required": [
        "verdict",
        "fulfilled",
        "playback"
      ],
      "title": "Review",
      "type": "object"
    },
    "ReviewRender": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/Pin"
        },
        "manifest": {
          "$ref": "#/$defs/Pin"
        },
        "selection_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "manifest",
        "selection_hash"
      ],
      "title": "ReviewRender",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "take": {
          "$ref": "#/$defs/Take"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "reviewed_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reviewed Fingerprint",
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/Authority"
        },
        "acceptance_revision": {
          "exclusiveMinimum": 0,
          "title": "Acceptance Revision",
          "type": "integer"
        },
        "valid": {
          "default": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "take",
        "review",
        "reviewed_fingerprint",
        "approval",
        "acceptance_revision"
      ],
      "title": "Selection",
      "type": "object"
    },
    "SourceRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceRange",
      "type": "object"
    },
    "Take": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Id"
        },
        "origin": {
          "default": "generated",
          "enum": [
            "generated",
            "approved_reuse"
          ],
          "title": "Origin",
          "type": "string"
        },
        "asset": {
          "$ref": "#/$defs/Pin"
        },
        "frame_count": {
          "exclusiveMinimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "fps": {
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "number"
        },
        "cfr": {
          "default": true,
          "title": "Cfr",
          "type": "boolean"
        },
        "pts_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pts Evidence"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "has_audio": {
          "title": "Has Audio",
          "type": "boolean"
        },
        "decode_evidence": {
          "minLength": 1,
          "title": "Decode Evidence",
          "type": "string"
        },
        "source_range": {
          "$ref": "#/$defs/SourceRange"
        },
        "range_revision": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Range Revision",
          "type": "integer"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "id",
        "clip_id",
        "attempt_id",
        "asset",
        "frame_count",
        "fps",
        "width",
        "height",
        "has_audio",
        "decode_evidence",
        "source_range",
        "fingerprint"
      ],
      "title": "Take",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "accepted",
        "conditional",
        "rejected"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "minLength": 1,
      "title": "Batch Id",
      "type": "string"
    },
    "scope_revision": {
      "minLength": 1,
      "title": "Scope Revision",
      "type": "string"
    },
    "selection_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Hash",
      "type": "string"
    },
    "selections": {
      "items": {
        "$ref": "#/$defs/Selection"
      },
      "title": "Selections",
      "type": "array"
    },
    "joins": {
      "items": {
        "$ref": "#/$defs/JoinReview"
      },
      "title": "Joins",
      "type": "array"
    },
    "flow": {
      "$ref": "#/$defs/FlowReview"
    },
    "receiver": {
      "minLength": 1,
      "title": "Receiver",
      "type": "string"
    },
    "rights_evidence": {
      "minLength": 1,
      "title": "Rights Evidence",
      "type": "string"
    },
    "handles": {
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Handles",
      "type": "array"
    },
    "handle_policy": {
      "default": "No reviewed exterior handles supplied; zero certified. Raw margins remain available for separate post review.",
      "title": "Handle Policy",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "scope_revision",
    "selection_hash",
    "selections",
    "joins",
    "flow",
    "receiver",
    "rights_evidence",
    "handles"
  ],
  "title": "Handoff",
  "type": "object"
}
