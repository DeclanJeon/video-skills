          "title": "Scope Revision",
          "type": "string"
        },
        "coverage_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Coverage Hash",
          "type": "string"
        },
        "clip_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Clip Hash",
          "type": "string"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "audio_requested": {
          "title": "Audio Requested",
          "type": "boolean"
        },
        "reuse_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
