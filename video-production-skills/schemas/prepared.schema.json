        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "audio": {
          "title": "Audio",
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/Pin"
        },
        "observed_mode": {
          "minLength": 1,
