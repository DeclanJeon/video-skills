{
  "$defs": {
    "Pin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256",
        "path"
      ],
      "title": "Pin",
      "type": "object"
    },
    "SourceRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "clip_id": {
      "title": "Clip Id",
      "type": "string"
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Attempt Id"
    },
    "origin": {
      "default": "generated",
      "enum": [
        "generated",
        "approved_reuse"
      ],
      "title": "Origin",
      "type": "string"
    },
    "asset": {
      "$ref": "#/$defs/Pin"
    },
    "frame_count": {
      "exclusiveMinimum": 0,
      "title": "Frame Count",
      "type": "integer"
    },
    "fps": {
      "exclusiveMinimum": 0,
      "title": "Fps",
      "type": "number"
    },
    "cfr": {
      "default": true,
      "title": "Cfr",
      "type": "boolean"
    },
    "pts_evidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pts Evidence"
    },
    "width": {
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "has_audio": {
      "title": "Has Audio",
      "type": "boolean"
    },
    "decode_evidence": {
      "minLength": 1,
      "title": "Decode Evidence",
      "type": "string"
    },
    "source_range": {
      "$ref": "#/$defs/SourceRange"
    },
    "range_revision": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Range Revision",
      "type": "integer"
    },
    "fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "id",
    "clip_id",
    "attempt_id",
    "asset",
    "frame_count",
    "fps",
    "width",
    "height",
    "has_audio",
    "decode_evidence",
    "source_range",
    "fingerprint"
  ],
  "title": "Take",
  "type": "object"
}
